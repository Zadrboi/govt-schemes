    "@types/otplib": "^7.0.0",
    "@types/qrcode": "^1.5.6",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "exifr": "^7.1.3",
    "gsap": "^3.15.1",
    "idb-keyval": "^6.3.0",
    "iron-session": "^9.1.1",
    "jose": "^6.2.18",
    "leaflet": "^1.9.4",
    "lenis": "^1.3.28",
    "lucide-react": "^0.460.0",
    "next": "^15.1.0",
    "otplib": "^13.6.0",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
