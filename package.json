{
  "name": "drishti",
  "version": "1.0.0",
  "private": true,
  "description": "Drishti (দৃষ্টি) — Real-Time Botanical Editorial Scheme Monitoring & Statutory Audit across Assam & North East India",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "lint": "next lint",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prisma:generate": "prisma generate",
    "prisma:db:push": "prisma db push",
    "prisma:seed": "node --loader ts-node/esm prisma/seed.ts || tsx prisma/seed.ts || node prisma/seed.js",
    "verify": "npm run typecheck && npm run test && npm run build"
  },
  "dependencies": {
    "@google/genai": "^3.6.1",
