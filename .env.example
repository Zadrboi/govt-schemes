# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL="file:./dev.db"
# DATABASE_URL="postgresql://user:password@host:5432/drishti?schema=public"

# Authentication & Security (Min 32 characters)
AUTH_SECRET="replace-with-a-secure-random-32-char-secret"

# Sahay AI Provider ("nvidia" | "gemini" | "ollama")
AI_PROVIDER="nvidia"

# Option A: NVIDIA NIM API (OpenAI-compatible)
NVIDIA_API_KEY=""
NVIDIA_BASE_URL="https://integrate.api.nvidia.com/v1"
NVIDIA_MODEL="meta/llama-3.1-8b-instruct"

# Option B: Google Gemini API
GEMINI_API_KEY=""
GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta"
GEMINI_MODEL="gemini-2.0-flash"

# Option C: Local Ollama
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_MODEL="llama3"

# Optional: Bhashini Indic Speech Services
BHASHINI_USER_ID=""
BHASHINI_API_KEY=""
